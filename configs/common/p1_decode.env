source "$(dirname "$0")/b1.env" 2>/dev/null || source configs/b1.env
export VLLM_NIXL_SIDE_CHANNEL_HOST=${OWN_IP:?}
export VLLM_NIXL_SIDE_CHANNEL_PORT=5600
export UCX_TLS=tcp,cuda_copy,cuda_ipc   # with tcp alone UCX mistakes VRAM for host memory and registerMem fails (round P)
export UCX_NET_DEVICES=all
export VLLM_FLAGS="$VLLM_FLAGS --kv-transfer-config '{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_consumer\"}'"
