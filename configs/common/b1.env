# source this, then: vllm serve $MODEL $VLLM_FLAGS
export MODEL=${MODEL:-Qwen/Qwen3-8B}
export CHUNK=${CHUNK:-2048}
export VLLM_FLAGS="--dtype bfloat16 --max-model-len 32768 --gpu-memory-utilization 0.90 --max-num-batched-tokens ${CHUNK} --max-num-seqs 256 --seed 0 --disable-log-requests --port ${PORT:-8000}"
# prefix caching: on for sharegpt/traces, off for random sweeps -> add --no-enable-prefix-caching when WL=random
