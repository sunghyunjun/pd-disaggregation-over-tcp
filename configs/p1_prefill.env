source "$(dirname "$0")/b1.env" 2>/dev/null || source configs/b1.env
export VLLM_NIXL_SIDE_CHANNEL_HOST=${OWN_IP:?}   # this node's private IP
export VLLM_NIXL_SIDE_CHANNEL_PORT=5600
export UCX_TLS=tcp
export UCX_NET_DEVICES=all
export VLLM_FLAGS="$VLLM_FLAGS --kv-transfer-config '{\"kv_connector\":\"NixlConnector\",\"kv_role\":\"kv_producer\"}'"
